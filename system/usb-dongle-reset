#!/bin/sh
# Після пробудження перепідключити бездротові USB-донгли (клавіатура, миша, геймпад…), які після сну
# лишаються «живими» для системи, але натиски від них не надходять. Це те саме, що витягнути й вставити донгл.
# Ставиться в /usr/lib/systemd/system-sleep/ — systemd-sleep викликає його з «pre» перед сном і «post» після.
#
# DEVICES — пристрої через пробіл у форматі idVendor:idProduct (взяти з `lsusb`, див. docs/FAQ.md).
DEVICES="379a:1807"      # HATOR 2.4G 1K — донгл клавіатури

[ "$1" = post ] || exit 0
for d in /sys/bus/usb/devices/*; do
    [ -f "$d/idVendor" ] || continue
    id="$(cat "$d/idVendor"):$(cat "$d/idProduct")"
    case " $DEVICES " in *" $id "*) ;; *) continue ;; esac
    echo 0 > "$d/authorized"
    sleep 0.5
    echo 1 > "$d/authorized"
    logger -t usb-dongle-reset "reconnected $id ($(basename "$d"))"
done
exit 0
