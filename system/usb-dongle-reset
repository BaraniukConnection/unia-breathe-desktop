#!/bin/sh
# After resume, reconnect wireless USB dongles (keyboard, mouse, gamepad…) that still look alive to the system
# after sleep but deliver no input. It is the same as unplugging the dongle and plugging it back in.
# Goes into /usr/lib/systemd/system-sleep/: systemd-sleep calls it with "pre" before sleep and "post" after.
#
# DEVICES: devices separated by spaces, as idVendor:idProduct (take them from `lsusb`, see docs/FAQ.md).
DEVICES="379a:1807"      # example: HATOR 2.4G 1K keyboard dongle

[ "$1" = post ] || exit 0
for d in /sys/bus/usb/devices/*; do
    [ -f "$d/idVendor" ] || continue
    id="$(cat "$d/idVendor"):$(cat "$d/idProduct")"
    case " $DEVICES " in *" $id "*) ;; *) continue ;; esac
    echo 0 > "$d/authorized"
    sleep 0.5
    echo 1 > "$d/authorized"
    logger -t usb-dongle-reset "reconnected $id ($(basename "$d"))"
done
exit 0
