module nvidia-sleep 1.0;

# Only for systems with SELinux (Fedora, RHEL…). The NVIDIA driver (NVreg_TemporaryFilePath=/var/tmp, kernel
# suspend notifiers) saves video memory to a file in /var/tmp as systemd-sleep and reads it back after resume.
# Without this rule SELinux will not let it open the file (NVRM … error -13), and suspend is cancelled.
# Building and installing: see docs/FAQ.md.
require {
    type systemd_sleep_t;
    type tmp_t;
    class file { create open read write append getattr setattr unlink };
    class dir { search write add_name remove_name getattr };
}

allow systemd_sleep_t tmp_t:file { create open read write append getattr setattr unlink };
allow systemd_sleep_t tmp_t:dir { search write add_name remove_name getattr };
