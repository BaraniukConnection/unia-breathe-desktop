pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Shell settings (~/.config/unia-breathe/settings.json) and the Hyprland config generated from them
// (~/.config/unia-breathe/hyprland.conf: hypr/unia.conf sources it last, so it overrides the main config).
Singleton {
    id: root
    readonly property string dir: Quickshell.env("HOME") + "/.config/unia-breathe"
    property var data: ({ pins: [], clock24: true, hypr: {} })
    property bool ready: false

    function set(key, value) {
        const d = Object.assign({}, data)
        d[key] = value
        data = d
        saveTimer.restart()
    }
    function setHypr(key, value) {
        const h = Object.assign({}, data.hypr ?? {})
        h[key] = value
        set("hypr", h)
    }

    function save() {
        store.setText(JSON.stringify(data, null, 2) + "\n")
        const h = data.hypr ?? {}
        const lines = Object.keys(h).sort().map(k => `${k} = ${h[k]}`)
        // rewrite the Hyprland config only when it really changed: Hyprland watches the file and reloads the whole
        // config on every write (borders flicker, Settings lays its windows out again)
        const txt = "# Generated by Unia Breathe Desktop settings: change things there\n" + lines.join("\n") + "\n"
        if (txt !== conf.text()) conf.setText(txt)
    }
    Timer { id: saveTimer; interval: 500; onTriggered: root.save() }

    FileView {
        id: store
        path: root.dir + "/settings.json"
        printErrors: false
        onLoaded: {
            try { root.data = Object.assign({ pins: [], clock24: true, hypr: {} }, JSON.parse(text())) } catch (e) {}
            root.ready = true
        }
        onLoadFailed: root.ready = true
    }
    FileView { id: conf; path: root.dir + "/hyprland.conf"; printErrors: false }
}
