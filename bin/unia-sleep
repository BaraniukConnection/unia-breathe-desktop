#!/bin/sh
# Sleep from the control centre / the ⏻ menu: lock like Super+L first, then sleep.
# Calling systemctl suspend straight away makes hypridle (before_sleep_cmd) start the lock screen in the middle of
# suspending: hyprlock does not finish appearing (half transparent), and the screen hangs after resume.
# So lock first, wait until hyprlock has really locked the session, and only then suspend.
loginctl lock-session

# hyprlock tells logind the session is locked (LockedHint); wait up to 5 s
i=0
while [ "$i" -lt 50 ]; do
    [ "$(loginctl show-session "${XDG_SESSION_ID:-auto}" -p LockedHint --value 2>/dev/null)" = yes ] && break
    sleep 0.1
    i=$((i + 1))
done
sleep 1    # let hyprlock finish drawing in

exec systemctl suspend
