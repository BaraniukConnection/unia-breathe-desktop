#!/usr/bin/env bash
# A notification for a screenshot / screencast with Open and Show in Folder buttons.
# unia-shot-notify <file> [video]
file="$1"
[ -f "$file" ] || exit 0
if [ "$2" = video ]; then
    title="Screencast saved"; body="${file##*/}"; icon="video-x-generic"
else
    title="Screenshot taken"; body="Copied to the clipboard"; icon="$file"
fi
action=$(notify-send -a "Screenshot" -i "$icon" -w \
    --action=default=Open --action=open=Open --action=folder="Show in Folder" "$title" "$body")
case "$action" in
    default|open) xdg-open "$file" ;;
    folder) xdg-open "$(dirname "$file")" ;;
esac
